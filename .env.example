# Moteurs (défaut sûr : mock / rules / none)
DAC_ASR_BACKEND=faster-whisper        # faster-whisper | mock
DAC_WHISPER_MODEL=large-v3
DAC_WHISPER_DEVICE=auto               # auto | cuda | cpu
DAC_WHISPER_DEVICE_INDEX=0            # GPU utilisé par Whisper s'il y en a plusieurs
DAC_WHISPER_COMPUTE_TYPE=default      # int8_float16 ≈ 2 Go de VRAM pour large-v3
DAC_PRON_BACKEND=wav2vec2             # wav2vec2 | mock | none  (nécessite espeak-ng)
DAC_PHONEME_DEVICE=auto               # auto | cpu | cuda | cuda:N

# Correcteur : anthropic (API Claude) | openai (serveur local compatible OpenAI) | rules
DAC_CORRECTOR_BACKEND=anthropic
DAC_ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
# Backend openai : llama.cpp (llama-server), vLLM, Ollama… Rien ne sort de la machine.
DAC_LLM_BASE_URL=http://127.0.0.1:8000/v1
DAC_LLM_MODEL=                        # vide = le modèle servi ; renseigné = refus si un autre est servi
DAC_LLM_API_KEY=
DAC_LLM_CHUNK=4                       # segments par requête (les modèles locaux décrochent sur les longues listes)

DAC_DATA_DIR=./data

# Docker compose uniquement
# DAC_BIND=127.0.0.1                  # 0.0.0.0 pour exposer sur le réseau local (pas d'authentification)
# DAC_API_PORT=8010
# DAC_HF_CACHE=~/.cache/huggingface   # poids Whisper / wav2vec2
# DAC_LLM_MODELS_DIR=/opt/llm/models  # profil llm : dossier des GGUF, DAC_LLM_GGUF=<fichier>
